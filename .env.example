# ---------------------------------------------------------------------------
# SpeedUp CMS — environment template. Copy to `.env` and adjust as needed.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by @workspace/db (Drizzle) and the API server.
DATABASE_URL=postgresql://postgres@localhost:5433/dronelogix

# Port the Express API server listens on.
API_PORT=8081

# Port the Vite frontend (speedup) dev server listens on.
PORT=8080

# Base path the frontend is served under.
BASE_PATH=/

# Secret used to sign admin session JWTs. Change in production.
JWT_SECRET=dev-speedup-cms-secret-change-me

# Directory (relative to api-server) where uploaded media is stored (local dev only).
UPLOAD_DIR=uploads

# Vercel Blob token — when set, uploads go to Vercel Blob instead of local disk.
# Leave empty for local development. Set this in the Vercel dashboard for prod.
# BLOB_READ_WRITE_TOKEN=

# Seed credentials for the initial super admin (created by `pnpm --filter ./lib/db seed`).
SEED_ADMIN_EMAIL=admin@speedup.com
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Site Owner
